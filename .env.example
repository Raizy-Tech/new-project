# Production AI Gateway
# Keep all secrets server-side in Vercel. Never put provider keys in browser JavaScript.

# Primary: OpenRouter's free router automatically selects an available free model.
OPENROUTER_API_KEY=your_openrouter_key
OPENROUTER_MODEL=openrouter/free

# Specialist: NVIDIA NIM
NVIDIA_API_KEY=your_nvidia_api_key
NVIDIA_MODEL=z-ai/glm-5-3-flash

# Existing fallbacks
LLM7_API_KEY=your_llm7_key
LLM7_MODEL=gpt-oss:20b

AI_GATEWAY_API_KEY=your_vercel_ai_gateway_key
AI_GATEWAY_MODEL=alibaba/qwen-3-235b

# Optional runtime settings
PUBLIC_APP_URL=https://sm-tailoring.vercel.app
AI_PROVIDER_TIMEOUT_MS=12000
